# Copy to ~/.config/t560-music-panel/config.ini ONLY if you need to override
# something. The whole file is optional.
#
# The panel announces itself over mDNS, so Home Assistant offers to add it as
# a discovered device; it finds Home Assistant the same way, and identifies
# itself by a per-device ID. Entity IDs, tile labels, and which controls each
# tile offers are configured in Home Assistant and read from the panel's own
# config sensor, which the panel caches so that it also starts while Home
# Assistant is down.
#
# The only file that is always required is the access token, beside this one.

#[home_assistant]
# Set this only when Home Assistant cannot be found over mDNS.
#url=http://192.168.1.100:8123
# The panel writes its own ID to panel-id on the first run, derived from the
# hardware address so that two tablets never collide. Set this only to
# override that, and it must match the ID the panel announces.
#panel_id=t560
# Set this only when that sensor was renamed in Home Assistant.
#config_entity=sensor.t560_config

# Every key in this section is owned by Home Assistant, which offers them on
# the panel's device. What is set here is only the fallback: it decides until
# the panel has read a configuration from Home Assistant, and again if the
# cached one is lost. Editing Home Assistant changes them within a second and
# without restarting anything, so there is normally no reason to set them here
# at all.
[panel]
# 1000 ms is responsive while keeping CPU/network use low. 500-30000 ms.
poll_interval_ms=1000
# Playlists change infrequently. 10000-3600000 ms.
playlist_poll_interval_ms=60000
# Turn the display off after this many seconds without touchscreen, key, or
# camera-detected activity. Use 0 to keep the display on until the Power
# button is pressed. Values are clamped to 5-3600 seconds. The Power and Home
# button handler applies it, and re-reads it whenever Home Assistant changes
# it.
screen_off_seconds=30
# How the panel draws itself: modern, or cassette for the cassette-deck
# faceplate. It is the whole interface, not only the player page. An
# unrecognised name is read as modern. This one is a real fallback rather than
# a dead letter: Home Assistant sends no skin until somebody picks one there,
# so what is set here decides until then.
player_skin=modern

# Front camera motion detection. While the display is off, detected motion
# turns it on; while motion continues, the automatic screen off above is
# postponed. Analysis runs in the separate t560-motion-detector.py daemon,
# never in the panel process.
[camera]
# The built-in SM-T560 camera cannot be used: its DCAM driver rejects
# VIDIOC_REQBUFS, so no application can capture frames from it. Keep this off
# on that tablet. Set it to on for hardware whose camera answers
# `t560-motion-detector.py --probe` with "capture works".
motion_detection=off
# auto probes every /dev/video* capture node in ascending order. Set the node
# of the front camera explicitly when several nodes accept capture; see
# docs/CAMERA.md for the identification commands.
device=auto
# Capture resolution. The frames are only compared block by block, so the
# lowest resolution the sensor accepts is enough. Clamped to 160-640x120-480.
width=320
height=240
# Time between two analysed frames, 100-5000 ms. 400 ms is 2.5 frames/s.
frame_interval_ms=400
# A block counts as changed when its average brightness moves this far away
# from the change of the whole frame, 2-128.
pixel_threshold=12
# Share of the 16x12 blocks that must change before a frame counts as motion,
# 1-100 percent. Raise it when the sensor is noisy.
motion_area_percent=8
# Consecutive changed frames required before motion is reported, 1-10.
motion_frames=2
# Minimum interval between two reported motion events, 1-60 seconds.
cooldown_seconds=2
# Motion is ignored for this long after the Power button turned the display
# off, so that the person who pressed it does not immediately wake it again,
# 0-600 seconds. After an automatic screen off, motion wakes the display
# within a few seconds regardless of this value.
motion_wake_grace_seconds=30
