diff --git a/drivers/media/sprd_dcam/common/dcam_v4l2.c b/drivers/media/sprd_dcam/common/dcam_v4l2.c
--- a/drivers/media/sprd_dcam/common/dcam_v4l2.c
+++ b/drivers/media/sprd_dcam/common/dcam_v4l2.c
@@ -204,6 +204,18 @@ MODULE_PARM_DESC(gtelwifi_camera_unsafe_open_once,
 	"Allow exactly one manually armed SM-T560 camera open");
 /* camera-r17: read-only CSI-2 host snapshot, see sprd_sensor/csi2/csi_api.c */
 void csi_api_gtelwifi_dump(const char *tag);
+/*
+ * camera-r18: the r17 frame captured through CSI PHY C showed the sensor
+ * bytes arriving in UYVY/VYUY order while the capture unit was programmed
+ * for YUYV (luma plane flat at 128, the picture sitting in the chroma
+ * plane). Root may pick the DCAM_CAP_YUV_TYPE pattern for the next open:
+ * 0=YUYV 1=YVYU 2=UYVY (default) 3=VYUY.
+ */
+static unsigned int gtelwifi_camera_yuv_pattern = DCAM_UYVY;
+module_param_named(gtelwifi_camera_yuv_pattern,
+	gtelwifi_camera_yuv_pattern, uint, 0600);
+MODULE_PARM_DESC(gtelwifi_camera_yuv_pattern,
+	"SM-T560 DCAM capture YUV byte order: 0=YUYV 1=YVYU 2=UYVY (default) 3=VYUY");
 #endif
 
 #ifndef __SIMULATOR__
@@ -2444,7 +2456,18 @@ LOCAL int sprd_init_handle(struct file *file)
 	memset(info, 0, sizeof(*info));
 	info->if_mode = DCAM_CAP_IF_CSI2;
 	info->sn_mode = DCAM_CAP_MODE_YUV;
+#if defined(CONFIG_MACH_GTELWIFI)
+	info->yuv_ptn = gtelwifi_camera_yuv_pattern;
+	if (info->yuv_ptn >= DCAM_PATTERN_MAX) {
+		printk("camera-r18: invalid gtelwifi_camera_yuv_pattern %u, using UYVY\n",
+			info->yuv_ptn);
+		info->yuv_ptn = DCAM_UYVY;
+	}
+	printk("camera-r18: DCAM capture YUV pattern=%u (0=YUYV 1=YVYU 2=UYVY 3=VYUY)\n",
+		info->yuv_ptn);
+#else
 	info->yuv_ptn = DCAM_YUYV;
+#endif
 	info->data_bits = DCAM_CAP_8_BITS;
 	info->lane_num = 1;
 	info->pclk = 480;
