-static bool gtelwifi_camera_unsafe_open_once;
-module_param_named(gtelwifi_camera_unsafe_open_once,
-	gtelwifi_camera_unsafe_open_once, bool, 0600);
-MODULE_PARM_DESC(gtelwifi_camera_unsafe_open_once,
-	"Allow exactly one manually armed SM-T560 camera open");
+/*
+ * camera-r19: the r14 one-shot guard is retired. The SM-T560 front camera
+ * path (CSI PHY C, UYVY capture order, NV21 320x240) delivered real frames
+ * in r18, so opens are allowed by default. A root-only kill switch remains
+ * for emergencies:
+ *   echo 1 > /sys/module/sprd_dcam/parameters/gtelwifi_camera_disable
+ */
+static bool gtelwifi_camera_disable;
+module_param_named(gtelwifi_camera_disable,
+	gtelwifi_camera_disable, bool, 0600);
+MODULE_PARM_DESC(gtelwifi_camera_disable,
+	"Refuse every SM-T560 camera open (emergency switch, default N)");
