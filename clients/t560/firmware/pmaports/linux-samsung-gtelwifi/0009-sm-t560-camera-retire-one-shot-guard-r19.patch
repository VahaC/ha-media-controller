 		printk(KERN_WARNING
-			"V4L2: SM-T560 camera open blocked; arm gtelwifi_camera_unsafe_open_once manually\n");
+			"V4L2: SM-T560 camera open refused by gtelwifi_camera_disable\n");
 		mutex_unlock(&dev->dcam_mutex);
 		return -EPERM;
 	}
-	gtelwifi_camera_unsafe_open_once = false;
-	printk(KERN_WARNING
