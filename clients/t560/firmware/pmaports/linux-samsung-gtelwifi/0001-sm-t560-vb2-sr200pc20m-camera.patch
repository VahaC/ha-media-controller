diff --git a/drivers/media/sprd_sensor/gtelwifi/sr200pc20m_gtelwifi.c b/drivers/media/sprd_sensor/gtelwifi/sr200pc20m_gtelwifi.c
new file mode 100644
index 00000000..8856f9e2
--- /dev/null
+++ b/drivers/media/sprd_sensor/gtelwifi/sr200pc20m_gtelwifi.c
@@ -0,0 +1,222 @@
+/*
+ * Minimal SR200PC20M support for the Samsung SM-T560 front camera.
+ *
+ * The original Spreadtrum stack passed sensor register tables from the
+ * Android camera HAL. postmarketOS has no HAL, so keep the board's existing
+ * power implementation and provide the one preview mode needed by V4L2.
+ *
+ * Register values are from a Samsung GPL SR200PC20M 50 Hz driver table.
+ * Keep this board-specific tuning unchanged until the sensor is reachable.
+ */
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/types.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-subdev.h>
+#include <video/sensor_drv_k.h>
+
+#include "../sensor_drv_sprd.h"
+#include "../power/sensor_power.h"
+#include "sr200pc20m_gtelwifi.h"
+#include "sr200pc20m_regs_50hz.h"
+
+#define SR200PC20M_CHIP_ID_REG  0x04
+#define SR200PC20M_CHIP_ID_B4   0xb4
+#define SR200PC20M_CHIP_ID_B8   0xb8
+#define SR200PC20M_I2C_ADDR     0x20
+#define SR200PC20M_CSI_PHY_ID   0x01
+#define SR200PC20M_CSI_LANES    1
+#define SR200PC20M_CSI_MBPS     480
+
+static DEFINE_MUTEX(sr200pc20m_lock);
+static int sr200pc20m_powered;
+static int sr200pc20m_streaming;
+static struct v4l2_subdev sr200pc20m_subdev;
+
+static int sr200pc20m_write(uint8_t reg, uint8_t value)
+{
+	int attempt;
+	int ret = -EIO;
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		ret = sensor_k_write_reg8(SR200PC20M_I2C_ADDR, reg, value);
+		if (!ret)
+			return 0;
+		msleep(2);
+	}
+	return ret;
+}
+
+static int sr200pc20m_write_table(const uint16_t *table, size_t count)
+{
+	size_t index;
+	int ret;
+
+	for (index = 0; index < count; index++) {
+		uint16_t command = table[index];
+		uint8_t reg = command >> 8;
+		uint8_t value = command & 0xff;
+
+		if (reg == 0xff) {
+			msleep(value * 10);
+			continue;
+		}
+		ret = sr200pc20m_write(reg, value);
+		if (ret) {
+			pr_err("sr200pc20m: register 0x%02x write failed: %d\n",
+			       reg, ret);
+			return ret;
+		}
+	}
+	return 0;
+}
+
+static int sr200pc20m_detect(void)
+{
+	uint8_t id = 0;
+	int ret;
+
+	ret = sr200pc20m_write(0x03, 0x00);
+	if (ret)
+		return ret;
+	pr_info("sr200pc20m: using I2C address 0x%02x\n",
+		SR200PC20M_I2C_ADDR);
+	ret = sensor_k_read_reg8(SR200PC20M_I2C_ADDR,
+				 SR200PC20M_CHIP_ID_REG, &id);
+	if (ret)
+		return ret;
+	if (id != SR200PC20M_CHIP_ID_B4 && id != SR200PC20M_CHIP_ID_B8) {
+		pr_err("sr200pc20m: unexpected chip id 0x%02x\n", id);
+		return -ENODEV;
+	}
+	pr_info("sr200pc20m: chip id 0x%02x\n", id);
+	return 0;
+}
+
+static int sr200pc20m_gtelwifi_power(int on)
+{
+	struct sensor_power main_cfg = { 0 };
+	struct sensor_power sub_cfg = { 0 };
+	int ret = 0;
+
+	mutex_lock(&sr200pc20m_lock);
+	if (!!on == !!sr200pc20m_powered)
+		goto out;
+
+	if (on) {
+		ret = sensor_power_on(SENSOR_SUB, &main_cfg, &sub_cfg);
+		if (!ret)
+			sr200pc20m_powered = 1;
+	} else {
+		ret = sensor_power_off(SENSOR_SUB, &main_cfg, &sub_cfg);
+		sr200pc20m_powered = 0;
+		sr200pc20m_streaming = 0;
+	}
+out:
+	mutex_unlock(&sr200pc20m_lock);
+	return ret;
+}
+
+static int sr200pc20m_gtelwifi_stream(int on)
+{
+	static const uint16_t stream_start[] = { 0x0300, 0x0130, 0xff0a };
+	static const uint16_t stream_stop[] = { 0x0300, 0x0131, 0xff0a };
+	int ret = 0;
+
+	mutex_lock(&sr200pc20m_lock);
+	if (!!on == !!sr200pc20m_streaming)
+		goto out;
+	if (!sr200pc20m_powered) {
+		ret = -EPIPE;
+		goto out;
+	}
+
+	if (on) {
+		ret = sensor_k_mipi_open(SR200PC20M_CSI_PHY_ID,
+					 SR200PC20M_CSI_LANES,
+					 SR200PC20M_CSI_MBPS);
+		if (ret)
+			goto out;
+		ret = sr200pc20m_detect();
+		if (ret)
+			goto close_mipi;
+		ret = sr200pc20m_write_table(sr200pc20m_Init_Reg,
+					      ARRAY_SIZE(sr200pc20m_Init_Reg));
+		if (ret)
+			goto close_mipi;
+		/* The vendor init table intentionally ends in sleep mode. */
+		ret = sr200pc20m_write_table(stream_start,
+					      ARRAY_SIZE(stream_start));
+		if (ret)
+			goto close_mipi;
+		sr200pc20m_streaming = 1;
+		pr_info("sr200pc20m: 800x600 preview stream started\n");
+		goto out;
+	}
+
+	ret = sr200pc20m_write_table(stream_stop, ARRAY_SIZE(stream_stop));
+	sensor_k_mipi_close(SR200PC20M_CSI_PHY_ID);
+	sr200pc20m_streaming = 0;
+	pr_info("sr200pc20m: preview stream stopped\n");
+	goto out;
+
+close_mipi:
+	sensor_k_mipi_close(SR200PC20M_CSI_PHY_ID);
+out:
+	mutex_unlock(&sr200pc20m_lock);
+	return ret;
+}
+
+static int sr200pc20m_subdev_s_power(struct v4l2_subdev *sd, int on)
+{
+	(void)sd;
+	return sr200pc20m_gtelwifi_power(on);
+}
+
+static int sr200pc20m_subdev_s_stream(struct v4l2_subdev *sd, int on)
+{
+	(void)sd;
+	return sr200pc20m_gtelwifi_stream(on);
+}
+
+static const struct v4l2_subdev_core_ops sr200pc20m_core_ops = {
+	.s_power = sr200pc20m_subdev_s_power,
+};
+
+static const struct v4l2_subdev_video_ops sr200pc20m_video_ops = {
+	.s_stream = sr200pc20m_subdev_s_stream,
+};
+
+static const struct v4l2_subdev_ops sr200pc20m_subdev_ops = {
+	.core = &sr200pc20m_core_ops,
+	.video = &sr200pc20m_video_ops,
+};
+
+int sr200pc20m_gtelwifi_register_subdev(struct v4l2_device *v4l2_dev,
+				       struct v4l2_subdev **sensor_sd)
+{
+	int ret;
+
+	if (!v4l2_dev || !sensor_sd)
+		return -EINVAL;
+
+	v4l2_subdev_init(&sr200pc20m_subdev, &sr200pc20m_subdev_ops);
+	sr200pc20m_subdev.owner = THIS_MODULE;
+	strlcpy(sr200pc20m_subdev.name, "sr200pc20m-front",
+		sizeof(sr200pc20m_subdev.name));
+	ret = v4l2_device_register_subdev(v4l2_dev, &sr200pc20m_subdev);
+	if (ret)
+		return ret;
+
+	*sensor_sd = &sr200pc20m_subdev;
+	return 0;
+}
+
+void sr200pc20m_gtelwifi_unregister_subdev(struct v4l2_subdev *sensor_sd)
+{
+	if (sensor_sd)
+		v4l2_device_unregister_subdev(sensor_sd);
+}
diff --git a/drivers/media/sprd_sensor/gtelwifi/sr200pc20m_gtelwifi.h b/drivers/media/sprd_sensor/gtelwifi/sr200pc20m_gtelwifi.h
new file mode 100644
index 00000000..d2d01053
--- /dev/null
+++ b/drivers/media/sprd_sensor/gtelwifi/sr200pc20m_gtelwifi.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _SR200PC20M_GTELWIFI_H_
+#define _SR200PC20M_GTELWIFI_H_
+
+struct v4l2_device;
+struct v4l2_subdev;
+
+#define SR200PC20M_PREVIEW_WIDTH  800
+#define SR200PC20M_PREVIEW_HEIGHT 600
+
