+LOCAL void sprd_vb2_return_buffers(struct dcam_dev *dev,
+				   enum vb2_buffer_state state)
+{
+	struct dcam_path_spec *path = &dev->dcam_cxt.dcam_path[DCAM_PATH1];
+	unsigned int index;
+
+	for (index = 0; index < dev->vb2_queue.num_buffers; index++) {
+		struct vb2_buffer *vb = dev->vb2_queue.bufs[index];
+		struct dcam_frame *frame = NULL;
+		unsigned long flags;
+
+		spin_lock_irqsave(&dev->vb2_lock, flags);
+		if (index < DCAM_FRM_CNT_MAX) {
+			frame = path->frm_ptr[index];
+			path->frm_ptr[index] = NULL;
+		}
+		spin_unlock_irqrestore(&dev->vb2_lock, flags);
+		if (frame)
+			dcam_frame_unlock(frame);
+		if (vb && vb->state == VB2_BUF_STATE_ACTIVE)
+			vb2_buffer_done(vb, state);
+	}
+}
