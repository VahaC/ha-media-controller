+	mutex_lock(&s_p_sensor_mod->sensor_lock);
+	msg[0].addr = i2c_addr;
+	msg[0].flags = 0;
+	msg[0].buf = &reg;
+	msg[0].len = 1;
+	msg[1].addr = i2c_addr;
+	msg[1].flags = I2C_M_RD;
+	msg[1].buf = value;
+	msg[1].len = 1;
+	ret = i2c_transfer(s_p_sensor_mod->cur_i2c_client->adapter, msg, 2);
+	mutex_unlock(&s_p_sensor_mod->sensor_lock);
+
+	return ret == 2 ? 0 : (ret < 0 ? ret : -EIO);
+}
