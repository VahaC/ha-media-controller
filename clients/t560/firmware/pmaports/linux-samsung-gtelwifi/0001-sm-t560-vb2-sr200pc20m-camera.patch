+LOCAL int sprd_vb2_queue_setup(struct vb2_queue *queue,
+			       const struct v4l2_format *format,
+			       unsigned int *num_buffers,
+			       unsigned int *num_planes,
+			       unsigned int sizes[], void *alloc_ctxs[])
+{
+	struct dcam_dev *dev = vb2_get_drv_priv(queue);
+	struct dcam_path_spec *path = &dev->dcam_cxt.dcam_path[DCAM_PATH1];
+	struct v4l2_pix_format pix;
+
+	if (*num_buffers > DCAM_PATH_1_FRM_CNT_MAX)
+		*num_buffers = DCAM_PATH_1_FRM_CNT_MAX;
+	memset(&pix, 0, sizeof(pix));
+	pix.width = path->out_size.w;
+	pix.height = path->out_size.h;
+	pix.pixelformat = sprd_v4l2_get_fourcc(path);
+	sprd_v4l2_fill_pix_layout(&pix);
+	if (!pix.sizeimage)
+		return -EINVAL;
+
+	*num_planes = 1;
+	sizes[0] = pix.sizeimage;
+	alloc_ctxs[0] = dev->vb2_alloc_ctx;
+	return 0;
+}
+
+LOCAL int sprd_vb2_buffer_prepare(struct vb2_buffer *vb)
+{
+	struct dcam_dev *dev = vb2_get_drv_priv(vb->vb2_queue);
+	struct dcam_path_spec *path = &dev->dcam_cxt.dcam_path[DCAM_PATH1];
+	struct v4l2_pix_format pix;
+
+	memset(&pix, 0, sizeof(pix));
+	pix.width = path->out_size.w;
+	pix.height = path->out_size.h;
+	pix.pixelformat = sprd_v4l2_get_fourcc(path);
+	sprd_v4l2_fill_pix_layout(&pix);
+	if (vb2_plane_size(vb, 0) < pix.sizeimage)
+		return -EINVAL;
+	vb2_set_plane_payload(vb, 0, pix.sizeimage);
+	return 0;
+}
+
+LOCAL void sprd_vb2_buffer_queue(struct vb2_buffer *vb)
+{
+	struct dcam_dev *dev = vb2_get_drv_priv(vb->vb2_queue);
+	struct dcam_path_spec *path = &dev->dcam_cxt.dcam_path[DCAM_PATH1];
+	dma_addr_t dma = vb2_dma_contig_plane_dma_addr(vb, 0);
+	uint32_t pixels = path->out_size.w * path->out_size.h;
+	uint32_t fourcc = sprd_v4l2_get_fourcc(path);
+	struct dcam_frame *frame = NULL;
+	unsigned long flags;
+	unsigned int index = vb->v4l2_buf.index;
+
+	if (index >= DCAM_PATH_1_FRM_CNT_MAX) {
+		vb2_buffer_done(vb, VB2_BUF_STATE_ERROR);
+		return;
+	}
+
+	path->frm_addr[index].yaddr = (uint32_t)dma;
+	path->frm_addr[index].uaddr = 0;
+	path->frm_addr[index].vaddr = 0;
+	if (fourcc == V4L2_PIX_FMT_NV12 || fourcc == V4L2_PIX_FMT_NV21) {
+		path->frm_addr[index].uaddr = (uint32_t)dma + pixels;
+	} else if (fourcc == V4L2_PIX_FMT_YUV420 ||
+		   fourcc == V4L2_PIX_FMT_YVU420) {
+		path->frm_addr[index].uaddr = (uint32_t)dma + pixels;
+		path->frm_addr[index].vaddr = (uint32_t)dma + pixels + pixels / 4;
+		if (fourcc == V4L2_PIX_FMT_YVU420) {
+			uint32_t tmp = path->frm_addr[index].uaddr;
+			path->frm_addr[index].uaddr = path->frm_addr[index].vaddr;
+			path->frm_addr[index].vaddr = tmp;
+		}
+	} else if (fourcc == V4L2_PIX_FMT_YUV422P) {
+		path->frm_addr[index].uaddr = (uint32_t)dma + pixels;
+		path->frm_addr[index].vaddr = (uint32_t)dma + pixels + pixels / 2;
+	}
+
+	if (path->frm_cnt_act < index + 1)
+		path->frm_cnt_act = index + 1;
+	path->frm_type = DCAM_PATH1;
+	path->is_work = 1;
+
+	spin_lock_irqsave(&dev->vb2_lock, flags);
+	frame = path->frm_ptr[index];
+	path->frm_ptr[index] = NULL;
+	spin_unlock_irqrestore(&dev->vb2_lock, flags);
+	if (frame)
+		dcam_frame_unlock(frame);
+}
+
+LOCAL int sprd_vb2_start_streaming(struct vb2_queue *queue,
+				   unsigned int count)
+{
+	struct dcam_dev *dev = vb2_get_drv_priv(queue);
+	int ret;
+
+	if (!count)
+		return -EINVAL;
+	dev->vb2_sequence = 0;
+#if defined(CONFIG_MACH_GTELWIFI)
+	ret = v4l2_subdev_call(dev->sensor_sd, video, s_stream, 1);
+	if (ret)
+		goto error;
+#endif
+	ret = sprd_v4l2_start_hardware(dev);
+	if (!ret)
+		return 0;
+#if defined(CONFIG_MACH_GTELWIFI)
+	v4l2_subdev_call(dev->sensor_sd, video, s_stream, 0);
+#endif
+error:
+	sprd_vb2_return_buffers(dev, VB2_BUF_STATE_ERROR);
+	return ret;
+}
+
+LOCAL int sprd_vb2_stop_streaming(struct vb2_queue *queue)
+{
+	struct dcam_dev *dev = vb2_get_drv_priv(queue);
+	int ret;
+
+	ret = sprd_v4l2_stop_hardware(dev);
+#if defined(CONFIG_MACH_GTELWIFI)
+	v4l2_subdev_call(dev->sensor_sd, video, s_stream, 0);
+#endif
+	sprd_vb2_return_buffers(dev, VB2_BUF_STATE_ERROR);
+	return ret;
+}
+
+LOCAL const struct vb2_ops sprd_vb2_ops = {
+	.queue_setup = sprd_vb2_queue_setup,
+	.buf_prepare = sprd_vb2_buffer_prepare,
+	.buf_queue = sprd_vb2_buffer_queue,
+	.start_streaming = sprd_vb2_start_streaming,
+	.stop_streaming = sprd_vb2_stop_streaming,
+};
