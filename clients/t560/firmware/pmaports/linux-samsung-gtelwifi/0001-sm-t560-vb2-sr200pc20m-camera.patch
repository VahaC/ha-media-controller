+int sensor_k_mipi_open(uint32_t phy_id, uint32_t lane_num,
+		       uint32_t bps_per_lane)
+{
+	int ret;
+
+	if (!s_p_sensor_mod || !s_sensor_of_node)
+		return -ENODEV;
+
+	mutex_lock(&s_p_sensor_mod->sensor_lock);
+	if (s_p_sensor_mod->mipi_on) {
+		mutex_unlock(&s_p_sensor_mod->sensor_lock);
+		return 0;
+	}
+
+	/* clk_dcam_mipi belongs to the sensor DT node, not sprd_dcam. */
+	ret = _sensor_k_mipi_clk_en(s_sensor_of_node);
+	if (ret)
+		goto out;
+	udelay(1);
+	ret = csi_api_init(bps_per_lane, phy_id);
+	if (ret)
+		goto disable_clk;
+	ret = csi_api_start();
+	if (ret)
+		goto close_csi;
+	ret = csi_set_on_lanes(lane_num);
+	if (ret)
+		goto close_csi;
+
+	s_p_sensor_mod->mipi_on = 1;
+	printk("SENSOR: MIPI on, phy 0x%x, lane %u, bps %u\n",
+		phy_id, lane_num, bps_per_lane);
+	goto out;
+
+close_csi:
+	csi_api_close(phy_id);
+disable_clk:
+	_sensor_k_mipi_clk_dis();
+out:
+	mutex_unlock(&s_p_sensor_mod->sensor_lock);
+	return ret;
+}
+
+int sensor_k_mipi_close(uint32_t phy_id)
+{
+	int ret = 0;
+
+	if (!s_p_sensor_mod)
+		return -ENODEV;
+
+	mutex_lock(&s_p_sensor_mod->sensor_lock);
+	if (s_p_sensor_mod->mipi_on) {
+		ret = csi_api_close(phy_id);
+		_sensor_k_mipi_clk_dis();
+		s_p_sensor_mod->mipi_on = 0;
+		printk("SENSOR: MIPI off\n");
+	}
+	mutex_unlock(&s_p_sensor_mod->sensor_lock);
+	return ret;
+}
