#!/bin/sh

export LANG=en_US.UTF-8
export LANGUAGE=en_US:en
export LC_ALL=en_US.UTF-8
export GTK_THEME=Adwaita:dark

# Disable the screen saver and the inherited timeouts. The Power handler
# controls DPMS explicitly, applies the configured inactivity timeout, and
# allows any key or touchscreen input to wake the display.
xset s off
xset s noblank
xset -dpms

mkdir -p "$HOME/.local/state"

# No WebKit and no Matchbox Keyboard are started for this panel.
python3 "$HOME/.local/bin/t560-cursor.py" >>"$HOME/.local/state/cursor.log" 2>&1 &
tint2 -c "$HOME/.config/tint2/desktop-tint2rc" >>"$HOME/.local/state/desktop.log" 2>&1 &
tint2 -c "$HOME/.config/tint2/tint2rc" >>"$HOME/.local/state/tint2.log" 2>&1 &

# Turn off the display on a short Power press and retain the long-press menu.
python3 "$HOME/.local/bin/t560-power-button.py" >>"$HOME/.local/state/power-button.log" 2>&1 &

# Wake the display on front-camera motion. The daemon exits by itself when
# motion detection is disabled in config.ini or no camera node is usable.
python3 "$HOME/.local/bin/t560-motion-detector.py" >>"$HOME/.local/state/motion-detector.log" 2>&1 &

# Native panel watchdog replaces t560-badwolf-watchdog.
panel_watchdog="$HOME/.local/bin/t560-panel-watchdog"
if [ ! -x "$panel_watchdog" ]; then
    panel_watchdog=/usr/bin/t560-panel-watchdog
fi
"$panel_watchdog" &
