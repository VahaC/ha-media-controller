<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <gresource prefix="/com/vahac/t560">
    <!-- The layout editor the panel serves on its own port. It is one
         self-contained page: the tablet is often on a network with no
         route to anywhere, so nothing in it may be fetched from a CDN. -->
    <file>editor.html</file>
    <!-- What each skin looks like, shown beside the list of them in the
         editor. Static images rather than a live preview: drawing one would
         mean a second implementation of every skin, in JavaScript. They are
         generated by tools/make-skin-previews.py. -->
    <file>skins/modern.png</file>
    <file>skins/cassette.png</file>
    <file>icons/light-1.png</file>
    <file>icons/light-2.png</file>
    <file>icons/fan.png</file>
    <file>icons/ac.png</file>
    <file>icons/desk-lamp.png</file>
    <file>icons/desk-led-strip.png</file>
  </gresource>
</gresources>
